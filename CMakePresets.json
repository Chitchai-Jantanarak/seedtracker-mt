{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw-base",
      "hidden": true,
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "mingw-release",
      "inherits": "mingw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG"
      }
    },
    {
      "name": "mingw-release-opencl",
      "inherits": "mingw-release",
      "cacheVariables": {
        "SEEDTRACKER_OPENCL": "ON"
      }
    },
    {
      "name": "mingw-debug",
      "inherits": "mingw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release"
    },
    {
      "name": "mingw-release-opencl",
      "configurePreset": "mingw-release-opencl"
    },
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug"
    }
  ]
}